# ---------------------------------------------------------------
# Kopiera denna fil till .env.local och fyll i värdena per kund.
# ---------------------------------------------------------------

# Vilken kund som byggs - måste finnas i content/kunder.ts.
# Utelämnas variabeln byggs demokunden (bjorken).
NEXT_PUBLIC_KUND="bjorken"

# Publik adress till sajten (används för SEO, sitemap och OG-bilder)
NEXT_PUBLIC_SAJT_URL="https://www.exempelrestaurang.se"

# E-post via Resend (https://resend.com) - krävs för kontaktformuläret
RESEND_API_KEY=""
KONTAKT_AVSANDARE="hemsida@exempelrestaurang.se"
KONTAKT_MOTTAGARE="info@exempelrestaurang.se"

# Google Search Console-verifiering (valfritt)
NEXT_PUBLIC_GOOGLE_VERIFIERING=""
